{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frederikgeth/BMOPFTools.jl/schemas/finding-registry.schema.json",
  "title": "BMOPFTools Finding registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "source", "finding_count", "findings"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "registry_id": {"const": "bmopftools-findings-0.1.0"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"const": "docs/src/findings.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "finding_count": {"type": "integer", "minimum": 1},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/findingExplanation"}
    }
  },
  "$defs": {
    "findingExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "namespace", "catalogue_section", "section_title", "meaning", "contract_id", "knowledge_ids"],
      "properties": {
        "code": {"type": "string", "pattern": "^[EWI]\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)+$"},
        "severity": {"enum": ["ERROR", "WARNING", "INFO"]},
        "namespace": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "catalogue_section": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
        "section_title": {"type": "string", "minLength": 1},
        "meaning": {"type": "string", "minLength": 1},
        "contract_id": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9_]*$"},
        "knowledge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PSK-[0-9]{6}$"}
        }
      }
    }
  }
}
