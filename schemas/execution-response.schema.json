{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frederikgeth/BMOPFTools.jl/schemas/execution-response.schema.json",
  "title": "BMOPFTools execution response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation",
    "status",
    "package",
    "request",
    "inputs"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "operation": {"const": "check_contract"},
    "status": {
      "enum": ["passed", "failed", "inapplicable", "indeterminate", "error"]
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "BMOPFTools"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "parameters"],
      "properties": {
        "contract_id": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "parameters": {"type": "object"}
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "status",
        "knowledge_ids",
        "checked_dimensions",
        "unassessed_dimensions",
        "findings",
        "evidence"
      ],
      "properties": {
        "contract_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {"enum": ["passed", "failed", "inapplicable", "indeterminate"]},
        "knowledge_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^PSK-[0-9]{6}$"}
        },
        "checked_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "unassessed_dimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "evidence": {"type": "object"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "section",
        "component_type",
        "component_id",
        "message",
        "detail"
      ],
      "properties": {
        "severity": {"enum": ["ERROR", "WARNING", "INFO"]},
        "code": {"type": "string", "pattern": "^[EWI]\\.[A-Z0-9_]+(?:\\.[A-Z0-9_]+)+$"},
        "section": {"type": "string", "minLength": 1},
        "component_type": {"type": "string", "minLength": 1},
        "component_id": {"type": ["string", "null"]},
        "message": {"type": "string", "minLength": 1},
        "detail": {"type": ["object", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "error"}}},
      "then": {
        "required": ["error"],
        "not": {"required": ["result"]}
      },
      "else": {
        "required": ["result"],
        "not": {"required": ["error"]}
      }
    }
  ]
}
