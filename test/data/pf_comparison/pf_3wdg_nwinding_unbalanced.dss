! General n-winding transformer (3-winding, all-wye) under UNBALANCED loading.
! Single-phase loads on different phases of the MV and LV windings exercise the
! per-phase independence of the star/T model. Same conventions as
! pf_3wdg_nwinding.dss (model=ideal stiff source, Vminpu/Vmaxpu, solid grounds).
Clear
Set DefaultBaseFreq=60

New Circuit.pf_3wdg_nwinding_unb basekv=115 pu=1.0 angle=0 phases=3 bus1=hv model=ideal

New Reactor.grnd_hv bus1=hv.4 bus2=hv.0 R=0.0001 X=0 phases=1

New Transformer.t1 windings=3 phases=3
~ wdg=1 bus=hv.1.2.3.4 conn=wye kv=115  kva=30000 %r=0.3
~ wdg=2 bus=mv.1.2.3.4 conn=wye kv=24.9 kva=30000 %r=0.4
~ wdg=3 bus=lv.1.2.3.4 conn=wye kv=4.16 kva=30000 %r=0.4
~ XHL=8 XHT=8 XLT=6 %noloadloss=0 %imag=0

New Reactor.grnd_mv bus1=mv.4 bus2=mv.0 R=0.0001 X=0 phases=1
New Reactor.grnd_lv bus1=lv.4 bus2=lv.0 R=0.0001 X=0 phases=1

! Unbalanced single-phase loads (phase a, b on MV; phase c on LV).
New Load.m1 bus1=mv.1.4 conn=wye kv=14.376 kw=2000 kvar=400 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.m2 bus1=mv.2.4 conn=wye kv=14.376 kw=500  kvar=50  phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.l3 bus1=lv.3.4 conn=wye kv=2.402  kw=1200 kvar=300 phases=1 model=1 Vminpu=0 Vmaxpu=2

Set VoltageBases=[115, 24.9, 4.16]
CalcVoltageBases
Set Tolerance=1e-9
Solve
