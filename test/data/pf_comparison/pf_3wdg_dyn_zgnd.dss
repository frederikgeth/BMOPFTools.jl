! 3-winding Dyn transformer with an IMPEDANCE-grounded MV neutral, unbalanced load.
! wdg1 HV delta 115 kV (source-grounded), wdg2 MV wye 24.9 kV grounded through a
! Z = 0.5 Ω reactor (not solid), wdg3 LV wye 4.16 kV solidly grounded. Under the
! unbalanced single-phase MV loads the neutral current flows through the 0.5 Ω
! grounding impedance, lifting mv.4 off earth — the neutral-grounding dimension.
! The MV neutral voltage rise (mv.4) is part of the comparison. Same conventions
! as pf_3wdg_dyn.dss.
Clear
Set DefaultBaseFreq=60

New Circuit.pf_3wdg_dyn_zgnd basekv=115 pu=1.0 angle=0 phases=3 bus1=hv model=ideal

New Transformer.t1 windings=3 phases=3
~ wdg=1 bus=hv.1.2.3   conn=delta kv=115  kva=30000 %r=0.3
~ wdg=2 bus=mv.1.2.3.4 conn=wye   kv=24.9 kva=30000 %r=0.4
~ wdg=3 bus=lv.1.2.3.4 conn=wye   kv=4.16 kva=30000 %r=0.4
~ XHL=8 XHT=8 XLT=6 %noloadloss=0 %imag=0

New Reactor.grnd_mv bus1=mv.4 bus2=mv.0 R=0.5    X=0 phases=1
New Reactor.grnd_lv bus1=lv.4 bus2=lv.0 R=0.0001 X=0 phases=1

! Unbalanced single-phase MV loads → neutral current through the 0.5 Ω ground.
New Load.m1 bus1=mv.1.4 conn=wye kv=14.376 kw=2500 kvar=500 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.m2 bus1=mv.2.4 conn=wye kv=14.376 kw=800  kvar=150 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.ldlv bus1=lv.1.2.3.4 conn=wye kv=4.16 kw=900 kvar=180 phases=3 model=1 Vminpu=0 Vmaxpu=2

Set VoltageBases=[115, 24.9, 4.16]
CalcVoltageBases
Set Tolerance=1e-9
Solve
