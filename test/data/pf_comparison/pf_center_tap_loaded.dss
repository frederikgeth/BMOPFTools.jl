! Center-tap (split-phase) transformer under NON-TRIVIAL load, fed through a line
! so the HV-side voltage is load-sensitive.
!
! Regression guard for the center_tap ideal-core current-coupling sign. With the
! wrong sign (N·Is + Il1 + Il2 = 0) the transformer SOURCES spurious active power
! proportional to its load, so the HV-side voltage drops too little and total
! losses go negative. The correct coupling (N·Is + Il1 − Il2 = 0, reversed
! winding-3) conserves power and matches OpenDSS. The line impedance is what makes
! the bug observable — on a stiff bus the source pins the voltages and hides it.
!
! Topology: src ──[line, 5 km]── hv ──[center-tap 7.2kV/120-0-120]── lv
!   Heavily and unequally loaded legs to exercise both leg currents.

Clear

Set DefaultBaseFreq=50

New Circuit.pf_ct_loaded basekv=7.2 pu=1.0 angle=0 phases=1 bus1=src.1.0

New Reactor.grnd_src bus1=src.4 bus2=src.0 R=0.001 X=0 phases=1

! Single-conductor HV feeder with a meaningful series impedance.
New Linecode.sp1w nphases=1 Rmatrix=[0.6] Xmatrix=[0.4] Cmatrix=[0] units=km
New Line.l1 bus1=src.1 bus2=hv.1 linecode=sp1w length=5 units=km phases=1
! HV neutral earthed at the transformer.
New Reactor.grnd_hv bus1=hv.4 bus2=hv.0 R=0.001 X=0 phases=1

New Transformer.t1 phases=1 windings=3
~ wdg=1 bus=hv.1.4   conn=wye kv=7.2   kva=25 %r=0.6
~ wdg=2 bus=lv.1.4   conn=wye kv=0.120 kva=25 %r=1.2
~ wdg=3 bus=lv.4.2   conn=wye kv=0.120 kva=25 %r=1.2
~ XHL=2.04 XLT=1.36 XHT=2.04
~ %noloadloss=0.2

New Reactor.grnd_lv bus1=lv.4 bus2=lv.0 R=0.001 X=0 phases=1

! Heavy, unequal 120 V leg loads (≈ 80% of rating, leg-1 heavier).
New Load.ld1 bus1=lv.1.4 kv=0.120 kw=11 kvar=2 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.ld2 bus1=lv.4.2 kv=0.120 kw=8  kvar=1 phases=1 model=1 Vminpu=0 Vmaxpu=2

Set VoltageBases=[7.2, 0.120]
CalcVoltageBases
Set Tolerance=1e-8
Set MaxIterations=100
Solve
