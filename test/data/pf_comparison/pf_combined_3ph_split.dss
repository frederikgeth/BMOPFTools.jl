! Combined feeder: one 3-phase MV source feeding TWO transformer branches —
!   (1) a three-phase delta-wye (Dy) transformer → 3-phase LV load, and
!   (2) a split-phase center-tap transformer off one MV phase → 120/240 V legs.
!
! Purpose: exercise the Dy 30° vector-group shift AND the center-tap polarity
! TOGETHER under a (possibly non-zero) source-bus angle. Both branches' angle
! references trace back to the single Vsource, so the network is well-posed and
! the whole solution rotates rigidly with the source angle. Used to validate the
! BMOPF radians ↔ OpenDSS degrees source-angle convention (Layer B) and the
! angle-invariance of vector-group / voltage-level tagging (Layer C).
!
! Conventions match the other pf_comparison fixtures: model=ideal stiff source,
! Vminpu=0 Vmaxpu=2 (constant P/Q), solid grounding reactors, DefaultBaseFreq=50
! (BMOPF's modelling frequency), tight solve tolerance.

Clear
Set DefaultBaseFreq=50

New Circuit.pf_combined basekv=12.47 pu=1.0 angle=0 phases=3 bus1=src.1.2.3 model=ideal

! Source neutral (referenced by the single-phase center-tap winding) earthed.
New Reactor.grnd_src bus1=src.4 bus2=src.0 R=0.001 X=0 phases=1

! ── Branch 1: three-phase delta-wye (Dy) transformer, 12.47 kV Δ / 0.416 kV Y ──
New Transformer.t3 phases=3 windings=2
~ wdg=1 bus=src.1.2.3   conn=delta kv=12.47 %r=1.0 kva=500
~ wdg=2 bus=lv3.1.2.3.4 conn=wye   kv=0.416 %r=1.0 kva=500
~ xhl=4.0
~ %noloadloss=0.3
~ %imag=1.5
New Reactor.grnd_lv3 bus1=lv3.4 bus2=lv3.0 R=0.001 X=0 phases=1

! Slightly unbalanced 3-phase wye-to-neutral LV load (≈ 66 % of rating).
New Load.l3a bus1=lv3.1.4 kv=0.240 kw=120 kvar=40 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.l3b bus1=lv3.2.4 kv=0.240 kw=110 kvar=35 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.l3c bus1=lv3.3.4 kv=0.240 kw=100 kvar=30 phases=1 model=1 Vminpu=0 Vmaxpu=2

! ── Branch 2: split-phase center-tap transformer off MV phase a (7.2 kV LN) ────
New Transformer.tsp phases=1 windings=3
~ wdg=1 bus=src.1.4 conn=wye kv=7.2   kva=25 %r=0.6
~ wdg=2 bus=lvsp.1.4 conn=wye kv=0.120 kva=25 %r=1.2
~ wdg=3 bus=lvsp.4.2 conn=wye kv=0.120 kva=25 %r=1.2
~ XHL=2.04 XLT=1.36 XHT=2.04
~ %noloadloss=0.2
New Reactor.grnd_lvsp bus1=lvsp.4 bus2=lvsp.0 R=0.001 X=0 phases=1

! Unequal 120 V leg loads (≈ 76 % of rating, leg-1 heavier).
New Load.lsp1 bus1=lvsp.1.4 kv=0.120 kw=11 kvar=2 phases=1 model=1 Vminpu=0 Vmaxpu=2
New Load.lsp2 bus1=lvsp.4.2 kv=0.120 kw=8  kvar=1 phases=1 model=1 Vminpu=0 Vmaxpu=2

Set VoltageBases=[12.47, 0.416, 7.2, 0.24, 0.12]
CalcVoltageBases
Set Tolerance=1e-8
Set MaxIterations=100
Solve
