new circuit.lv25_232bus angle=-30.0000000000 basekv=11.0000000000 phases=3 bus1=B2995 model=ideal

set defaultbasefrequency=50.0000000000
set basefrequency=50.0000000000

redirect Linecodes.dss
redirect lines.dss
redirect Loads.dss
redirect Transformers.dss
redirect Switches.dss
redirect Groundings.dss

! batchedit removed: loads carry explicit kW=2.0 pf=0.95 (PowerIO drops batchedit silently, which desynced OpenDSS vs BMOPF)
solve
export Voltages

